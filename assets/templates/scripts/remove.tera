#!/bin/bash
# Genere par yunopack.

source _common.sh
source /usr/share/yunohost/helpers

# Le coeur de YunoHost deprovisionne les resources du manifest APRES ce script :
# utilisateur systeme, repertoire d'installation, base, ports. On ne retire ici
# que ce que le script d'installation a ajoute de son cote.

#=================================================
# RETRAIT DES CONFIGURATIONS SYSTEME
#=================================================
ynh_script_progression "Retrait des configurations systeme liees a $app..."
{% if features.fail2ban %}
ynh_config_remove_fail2ban
{%- endif %}
{%- if features.logrotate %}
ynh_config_remove_logrotate
{%- endif %}
{%- if features.service_integration %}

if ynh_hide_warnings yunohost service status "$app" >/dev/null; then
    yunohost service remove "$app"
fi
{%- for p in runtime.processus_annexes %}
if ynh_hide_warnings yunohost service status "$app-{{ p.nom }}" >/dev/null; then
    yunohost service remove "$app-{{ p.nom }}"
fi
{%- endfor %}
{%- endif %}
{%- if features.systemd %}
ynh_config_remove_systemd
{%- for m in runtime.montages %}
# Le point de montage que systemd a cree, et ses parents, s'ils sont vides.
rmdir -p "{{ m.image }}" 2>/dev/null || true
{%- endfor %}
{%- for v in runtime.volumes_lies %}
# Le point de montage que systemd a cree, s'il est vide.
rmdir "/{{ v }}" 2>/dev/null || true
{%- endfor %}
{%- for p in runtime.processus_annexes %}
ynh_config_remove_systemd "$app-{{ p.nom }}"
{%- endfor %}
{%- endif %}
{%- if features.nginx %}
ynh_config_remove_nginx
{%- endif %}
{%- if features.phpfpm %}
ynh_config_remove_phpfpm
{%- endif %}
{%- if features.cron %}

ynh_safe_rm "/etc/cron.d/$app"
{%- endif %}

# Les journaux ne sont pas effaces ici : le coeur s'en charge, et les detruire
# maintenant les ferait disparaitre si une mise a jour echouait et devait etre
# annulee.

#=================================================
# FIN DU SCRIPT
#=================================================

{%- if resources.s3 %}
s3_retirer
{%- endif %}
{%- if resources.redis %}
if [ -n "${redis_db:-}" ]; then
    ynh_redis_remove_db "$redis_db"
fi
{% endif %}
ynh_script_progression "Suppression de $app terminee"
