#!/bin/bash
# Genere par yunopack.

source _common.sh
source /usr/share/yunohost/helpers
{%- if runtime.construire_a_cote %}

#=================================================
# CONSTRUCTION, SERVICE EN MARCHE
#=================================================
# La compilation se fait a cote du repertoire de l'application, pendant que
# l'ancienne version continue de servir : le service n'est arrete que le
# temps d'echanger les deux repertoires.
construction="$install_dir.construction"
ynh_safe_rm "$construction"

ynh_script_progression "Mise a jour des sources de $app..."
ynh_setup_source --dest_dir="$construction"
chown -R "$app:www-data" "$construction"

{%- if resources.mongodb %}
mongo_version="${mongo_version:-7.0}"
ynh_install_mongo
{%- endif %}
{%- if resources.extensions_postgres | length > 0 %}

# Les extensions PostgreSQL que l'application active : leur creation demande
# le superutilisateur, que l'utilisateur de l'application n'est pas.
{%- for e in resources.extensions_postgres %}
ynh_psql_db_shell <<< 'CREATE EXTENSION IF NOT EXISTS "{{ e }}";'
{%- endfor %}
{%- endif %}
{%- if runtime.config_file or runtime.fichier_de_configuration %}
# La configuration en place, que la construction peut lire.
if [ -f "$install_dir/{{ runtime.config_file }}" ]; then
    cp -a "$install_dir/{{ runtime.config_file }}" "$construction/{{ runtime.config_file }}"
fi
{%- endif %}

ynh_script_progression "Construction de $app..."
pushd "$construction"
{%- if runtime.version_composer %}
    composer_version="{{ runtime.version_composer }}"
    composer_workdir="$construction" ynh_composer_install
    chown "$app:$app" "$construction/composer.phar"
    # Les scripts de composer l'appellent par son nom (`composer install`
    # dans un sous-projet, chez anonaddy).
    mkdir -p "$construction/.composer-bin"
    printf '#!/bin/sh\nexec php%s %s/composer.phar "$@"\n' "$php_version" "$construction" > "$construction/.composer-bin/composer"
    chmod +x "$construction/.composer-bin/composer"
    chown -R "$app:$app" "$construction/.composer-bin"
{%- endif %}
{%- if runtime.installer_rust %}
    # YunoHost ne fournit pas Rust : la chaine est posee ici le temps de la
    # construction, puis retiree.
    ynh_exec_as_app bash -c {{ runtime.installer_rust }}
{%- endif %}
{%- if runtime.installer_venv %}
    # L'application Python s'installe dans son propre environnement.
    ynh_exec_as_app bash -c {{ runtime.installer_venv }}
{%- endif %}
{%- for etape in runtime.build_steps %}
    ynh_exec_as_app {{ etape }}
{%- endfor %}
popd
{%- if runtime.rust_toolchain %}

# La chaine Rust et les objets de compilation pesent plusieurs Go, et ne
# servent plus une fois les binaires en place.
ynh_safe_rm "$construction/.cargo"
ynh_safe_rm "$construction/.rustup"
ynh_safe_rm "$construction/target"
{%- endif %}

#=================================================
# BASCULE
#=================================================
ynh_script_progression "Bascule sur la nouvelle version de $app..."
{%- if features.systemd %}

ynh_systemctl --service="$app" --action="stop"
{%- for p in runtime.processus_annexes %}
ynh_systemctl --service="$app-{{ p.nom }}" --action="stop"
{%- endfor %}
{%- endif %}
{%- if resources.s3 %}

# Le stockage S3 embarque passe dans le nouveau repertoire.
if [ -d "$install_dir/seaweedfs" ]; then
    mv "$install_dir/seaweedfs" "$construction/seaweedfs"
fi
{%- endif %}

ynh_safe_rm "$install_dir"
mv "$construction" "$install_dir"
# Les droits que la ressource install_dir pose a l'installation.
chmod 750 "$install_dir"
chown -R "$app:www-data" "$install_dir"
{%- else %}
{%- if features.systemd %}

#=================================================
# ARRET DU SERVICE
#=================================================
ynh_script_progression "Arret du service de $app..."

ynh_systemctl --service="$app" --action="stop"
{%- for p in runtime.processus_annexes %}
ynh_systemctl --service="$app-{{ p.nom }}" --action="stop"
{%- endfor %}
{%- endif %}

#=================================================
# MISE A JOUR DES SOURCES
#=================================================
ynh_script_progression "Mise a jour de $app..."

# --full_replace efface le repertoire avant de redeployer : sans cela, les
# fichiers supprimes en amont subsisteraient d'une version a l'autre.
ynh_setup_source --dest_dir="$install_dir" --full_replace{% if runtime.a_garder | length > 0 %} --keep="{{ runtime.a_garder | join(sep=" ") }}"{% endif %}
{% if not sources.extract %}
chmod +x "$install_dir/{{ sources.rename | default(value=app.id) }}"
{%- endif %}

chown -R "$app:www-data" "$install_dir"

{%- endif %}
{%- if resources.s3 %}

#=================================================
# STOCKAGE S3
#=================================================
ynh_script_progression "Mise a jour du stockage S3 de $app..."

# Les cles et le compartiment viennent des reglages : ils ne changent pas.
s3_installer
{%- endif %}
{%- if runtime.has_config %}

#=================================================
# CONFIGURATION
#=================================================
ynh_script_progression "Mise a jour de la configuration de $app..."
{%- if resources.redis %}

# La base Redis reservee a l'installation est dans les reglages ; un paquet
# installe par une version qui n'en avait pas en recoit une.
if [ -z "${redis_db:-}" ]; then
    redis_db=$(ynh_redis_get_free_db)
    ynh_app_setting_set --key=redis_db --value="$redis_db"
fi
{%- endif %}
{%- if runtime.a_un_secret %}

# Les reglages de l'application sont charges par YunoHost : le secret tire a
# l'installation est deja la. Un paquet installe par une version qui n'en
# avait pas en recoit un.
if [ -z "${secret:-}" ]; then
    secret=$(ynh_string_random --length=64)
    ynh_app_setting_set --key=secret --value="$secret"
fi
{%- endif %}
{%- for s in runtime.secrets_formates %}

if [ -z "${{ '{' }}{{ s.nom }}:-}" ]; then
    {{ s.nom }}=$({{ s.commande }})
    ynh_app_setting_set --key={{ s.nom }} --value="${{ s.nom }}"
fi
{%- endfor %}
{%- if runtime.a_une_cle_32 %}

if [ -z "${cle_32:-}" ]; then
    cle_32=$(ynh_string_random --length=32)
    ynh_app_setting_set --key=cle_32 --value="$cle_32"
fi
{%- endif %}

{%- if runtime.a_un_prefixe %}

# Le chemin sans sa barre finale : vide a la racine du domaine.
prefixe="${path%/}"
{%- endif %}
ynh_config_add --template="{{ runtime.config_file }}" --destination="$install_dir/{{ runtime.config_file }}"
chmod 400 "$install_dir/{{ runtime.config_file }}"
chown "$app:$app" "$install_dir/{{ runtime.config_file }}"
{%- endif %}
{%- if runtime.fichier_de_configuration %}

# La configuration que l'application lit, ecrite d'apres l'exemple du depot.
mkdir -p "$(dirname "$install_dir/{{ runtime.fichier_de_configuration.cible }}")"
ynh_config_add --template="{{ runtime.fichier_de_configuration.nom }}" --destination="$install_dir/{{ runtime.fichier_de_configuration.cible }}"
chmod 400 "$install_dir/{{ runtime.fichier_de_configuration.cible }}"
chown "$app:$app" "$install_dir/{{ runtime.fichier_de_configuration.cible }}"
{%- endif %}

{%- if not runtime.construire_a_cote %}
{%- if runtime.build_steps | length > 0 %}

#=================================================
# CONSTRUCTION
#=================================================
# Apres la configuration, que la construction peut lire.
ynh_script_progression "Construction de $app..."

pushd "$install_dir"
{%- if runtime.version_composer %}
    composer_version="{{ runtime.version_composer }}"
    ynh_composer_install
    chown "$app:$app" "$install_dir/composer.phar"
    # Les scripts de composer l'appellent par son nom (`composer install`
    # dans un sous-projet, chez anonaddy).
    mkdir -p "$install_dir/.composer-bin"
    printf '#!/bin/sh\nexec php%s %s/composer.phar "$@"\n' "$php_version" "$install_dir" > "$install_dir/.composer-bin/composer"
    chmod +x "$install_dir/.composer-bin/composer"
    chown -R "$app:$app" "$install_dir/.composer-bin"
{%- endif %}
{%- if runtime.installer_rust %}
    # YunoHost ne fournit pas Rust : la chaine est posee ici le temps de la
    # construction, puis retiree.
    ynh_exec_as_app bash -c {{ runtime.installer_rust }}
{%- endif %}
{%- if runtime.installer_venv %}
    # L'application Python s'installe dans son propre environnement.
    ynh_exec_as_app bash -c {{ runtime.installer_venv }}
{%- endif %}
{%- for etape in runtime.build_steps %}
    ynh_exec_as_app {{ etape }}
{%- endfor %}
popd
{%- if runtime.rust_toolchain %}

# La chaine Rust et les objets de compilation pesent plusieurs Go, et ne
# servent plus une fois les binaires en place.
ynh_safe_rm "$install_dir/.cargo"
ynh_safe_rm "$install_dir/.rustup"
ynh_safe_rm "$install_dir/target"
{%- endif %}
{%- endif %}
{%- endif %}
{%- if runtime.migrations_scripts | length > 0 %}

#=================================================
# MIGRATION DE LA BASE
#=================================================
ynh_script_progression "Migration de la base de $app..."

pushd "$install_dir"
{%- for m in runtime.migrations_scripts %}
    ynh_exec_as_app {{ m }}
{%- endfor %}
popd
{%- endif %}
{%- if features.cron %}

# Les taches planifiees de l'application.
ynh_config_add --template="cron" --destination="/etc/cron.d/$app"
chown root:root "/etc/cron.d/$app"
chmod 644 "/etc/cron.d/$app"
{%- endif %}

#=================================================
# CONFIGURATIONS SYSTEME
#=================================================
ynh_script_progression "Mise a jour des configurations systeme..."
{% if features.phpfpm %}
ynh_config_add_phpfpm
{%- endif %}
{%- if features.nginx %}
ynh_config_add_nginx
{%- endif %}
{%- if runtime.volumes_internes | length > 0 %}
# Les volumes de l'image sous son repertoire de travail : leurs donnees
# vivent dans le repertoire de donnees, l'installation y pointe.
{%- for v in runtime.volumes_internes %}
mkdir -p "$data_dir/{{ v }}"
if [ -d "$install_dir/{{ v }}" ] && [ ! -L "$install_dir/{{ v }}" ]; then
    cp -an "$install_dir/{{ v }}/." "$data_dir/{{ v }}/"
    ynh_safe_rm "$install_dir/{{ v }}"
fi
ln -sfn "$data_dir/{{ v }}" "$install_dir/{{ v }}"
{%- endfor %}
chown -R "$app:$app" "$data_dir"
{%- endif %}
{%- if features.systemd %}
ynh_config_add_systemd
{%- for p in runtime.processus_annexes %}
ynh_config_add_systemd --service="$app-{{ p.nom }}" --template="{{ p.nom }}.service"
{%- endfor %}
{%- endif %}
{%- if features.logrotate %}
ynh_config_add_logrotate
{%- endif %}
{%- if features.service_integration %}
yunohost service add "$app" --description="{{ app.name }}" --log="/var/log/$app/$app.log"
{%- for p in runtime.processus_annexes %}
yunohost service add "$app-{{ p.nom }}" --description="{{ app.name }} ({{ p.nom }})" --log="/var/log/$app/$app.log"
{%- endfor %}
{%- endif %}
{%- if features.systemd %}

#=================================================
# REDEMARRAGE DU SERVICE
#=================================================
ynh_script_progression "Redemarrage du service de $app..."

ynh_systemctl --service="$app" --action="start"
{%- for p in runtime.processus_annexes %}
ynh_systemctl --service="$app-{{ p.nom }}" --action="start"
{%- endfor %}
{%- endif %}

#=================================================
# FIN DU SCRIPT
#=================================================

ynh_script_progression "Mise a jour de $app terminee"
