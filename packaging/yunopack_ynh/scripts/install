#!/bin/bash
# Genere par yunopack.

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DEPLOIEMENT DES SOURCES
#=================================================
ynh_script_progression "Mise en place des fichiers de $app..."

ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:www-data" "$install_dir"

#=================================================
# CONFIGURATIONS SYSTEME
#=================================================
ynh_script_progression "Ajout des configurations systeme liees a $app..."

ynh_config_add_nginx

ynh_config_add_systemd

mkdir -p "/var/log/$app"
chown -R "$app:www-data" "/var/log/$app"
ynh_config_add_logrotate

yunohost service add "$app" --description="Yunopack" --log="/var/log/$app/$app.log"

#=================================================
# FICHIER DE REGLAGES
#=================================================

# Le panneau de configuration ecrit ici ; le service le lit au demarrage.
# Les jetons y figurent, d'ou les droits restreints au compte du service.
mkdir -p /etc/yunopack
touch /etc/yunopack/env

# Les cles doivent exister pour que le panneau de configuration sache ou
# ecrire ; il ne les cree pas lui-meme. Chacune est ajoutee si elle manque,
# et jamais reecrite : une mise a jour ne doit pas effacer un reglage.
ajouter_reglage() {
    grep -q "^$1=" /etc/yunopack/env || echo "$1=$2" >> /etc/yunopack/env
}
ajouter_reglage GITHUB_TOKEN ""
ajouter_reglage GITHUB_TOKEN_ECRITURE ""
ajouter_reglage GITLAB_TOKEN ""
ajouter_reglage YUNOPACK_CACHE_PARTAGE "https://raw.githubusercontent.com/EpicTGuy/yunopack/main/assets/evaluations.json"
ajouter_reglage YUNOPACK_HOTE_TEST ""
ajouter_reglage YUNOPACK_LANGUE "auto"

# Les jetons y figurent : lisible par le service, par personne d'autre.
chown root:"$app" /etc/yunopack/env
chmod 640 /etc/yunopack/env

#=================================================
# LOGO DU PORTAIL
#=================================================

# Le portail affiche le logo enregistre sur la permission ; sans lui,
# l'application apparait avec l'icone generique. Le catalogue officiel le
# fournirait, mais pas pour un paquet installe depuis une URL.
yunohost user permission update "$app.main" --logo "$YNH_APP_BASEDIR/conf/logo.png" 2>/dev/null || true

#=================================================
# DEMARRAGE DU SERVICE
#=================================================
ynh_script_progression "Demarrage du service de $app..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# FIN DU SCRIPT
#=================================================

ynh_script_progression "Installation de $app terminee"
